# BW21 extra kernel options appended on top of cnlohr's custom_kernel_config
# ---- block layer + virtio-blk (SD card as a disk) ----
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
# Partition table parsers so FAT32 SD partition appears as /dev/vda1
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# ---- networking: full TCP/IP + virtio-net ----
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
# ---- filesystems on the SD disk ----
CONFIG_EXT4_FS=y
CONFIG_EXT2_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# ---- virtio mmio bus (already present, keep explicit) ----
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# BW21 emulator executes RV32IMA in machine mode without an MMU.
CONFIG_RISCV=y
CONFIG_ARCH_RV32I=y
CONFIG_RISCV_M_MODE=y
# CONFIG_64BIT is not set
# CONFIG_MMU is not set
# CONFIG_SMP is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_FPU is not set
CONFIG_SIFIVE_PLIC=y
